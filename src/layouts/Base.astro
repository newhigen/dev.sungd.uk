---
import { ClientRouter } from 'astro:transitions';
import '../styles/site.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  /** 제목 뒤에 붙는 소속 — 기본은 «프로젝트». 노트 화면은 «노트»로, 목록처럼 안 붙일 땐 '' */
  suffix?: string;
}

const { title, description = '조성덕이 만든 앱 · 도구 · 대시보드 · 분석', image, suffix = '프로젝트' } = Astro.props;
const home = Astro.url.pathname === '/';
const full = home ? '프로젝트 — 조성덕' : suffix ? `${title} — ${suffix}` : title;
const ogImage = image ? new URL(image, Astro.site).href : undefined;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="128x128" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    {/* 고른 판을 그리기 전에 입힌다 — 본문 뒤에 두면 OS 판이 한 번 번쩍이고 바뀐다.
        아무것도 안 골랐으면 속성을 비워 둬 OS 설정을 그대로 따라간다 */}
    <script is:inline>
      (function () {
        function apply() {
          var r = document.documentElement;
          try {
            var t = localStorage.getItem('theme');
            if (t === 'light' || t === 'dark') r.dataset.theme = t;
            else delete r.dataset.theme;
          } catch (e) {}
        }
        apply();
        /* 쪽을 넘기면 문서 속성이 새 쪽 것으로 갈리므로 다시 입힌다 */
        document.addEventListener('astro:after-swap', apply);
        /* 제호 줄은 transition:persist 라 단추가 살아남지만, 위임으로 받으면
           그 줄을 안 쓰는 쪽이 생겨도 그대로 돈다 */
        document.addEventListener('click', function (e) {
          var b = e.target.closest && e.target.closest('button.theme');
          if (!b) return;
          var r = document.documentElement;
          var now = r.dataset.theme
            || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          var next = now === 'dark' ? 'light' : 'dark';
          r.dataset.theme = next;
          try { localStorage.setItem('theme', next); } catch (e2) {}
        });
      })();
    </script>

    <meta property="og:type" content="website" />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    <!-- 제목 페이퍼로지 · 본문 SUITE. @font-face 는 site.css 맨 위에 -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=GT-KT4BFVVJ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      // 내 기기 표시: 어느 사이트든 ?me=1 로 한 번 열면 .sungd.uk 쿠키가 심긴다 (?me=0 으로 해제)
      (function(){
        try {
          var m = new URLSearchParams(location.search).get('me')
          if (m === '1') document.cookie = 'sd_owner=1; domain=.sungd.uk; path=/; max-age=63072000; samesite=lax; secure'
          if (m === '0') document.cookie = 'sd_owner=; domain=.sungd.uk; path=/; max-age=0; samesite=lax; secure'
        } catch (e) {}
        window.__sdOwner = /(?:^|;\s*)sd_owner=1(?:;|$)/.test(document.cookie)
      })();
      gtag('set', 'user_properties', { visitor_type: window.__sdOwner ? 'owner' : 'visitor' });

      gtag('config', 'GT-KT4BFVVJ');
    </script>
    {/* 쪽을 넘길 때 문서를 새로 그리지 않는다 — 제목·제호는 그대로 두고 본문만 바뀐다 */}
    <ClientRouter />
  </head>
  <body>
    <div class="wrap">
      <header class="masthead" transition:persist>
        <a class="site" href="/">프로젝트</a>
        {/* 제호 줄은 이 사이트 안 이동만 맡는다 — 바깥으로 나가는 길은 바닥에 모았다 */}
        <nav>
          <a href="/notes/">노트</a>
          {/* 아이콘 전환은 CSS 가 맡는다 — 낮 판에는 달이, 밤 판에는 해가 선다.
              둘 다 그려 두고 지금 판이 아닌 쪽을 숨기는 꼴이라 JS 는 고르기만 한다 */}
          <button class="theme" type="button" aria-label="밤낮 바꾸기" title="밤낮 바꾸기">
            <svg class="only-light" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"
              fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 14.2A8.2 8.2 0 0 1 9.8 4 8.4 8.4 0 1 0 20 14.2Z" />
            </svg>
            <svg class="only-dark" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"
              fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="4.1" />
              <path d="M12 2.6v2.1M12 19.3v2.1M4.3 4.3l1.5 1.5M18.2 18.2l1.5 1.5M2.6 12h2.1M19.3 12h2.1M4.3 19.7l1.5-1.5M18.2 5.8l1.5-1.5" />
            </svg>
          </button>
        </nav>
      </header>

      <slot />

      <footer class="foot">
        <span class="ics">
          <a href="https://github.com/newhigen" aria-label="GitHub"><img src="/i/github.svg" alt="" /></a>
        </span>
        <a href="https://sungd.uk">sungd.uk</a>
      </footer>
    </div>

    <div class="zoombox" id="zoombox" role="dialog" aria-label="크게 본 그림" aria-modal="true" hidden>
      <button class="x" type="button" aria-label="닫기">✕</button>
      <img alt="" />
    </div>
    <script is:inline>
      (function () {
        var lb = document.getElementById('zoombox');
        if (!lb) return;
        var big = lb.querySelector('img');
        function open(src, alt) {
          big.src = src;
          big.alt = alt || '';
          lb.hidden = false;
        }
        function shut() { lb.hidden = true; }
        // 가로로 미는 줄에서는 밀고 손을 뗀 것이 누른 것으로 온다 — 움직였으면 안 연다
        var px = 0, py = 0;
        document.addEventListener('pointerdown', function (e) { px = e.clientX; py = e.clientY; }, true);
        // 위임으로 잡는다 — 펼치는 도식은 그림을 갈아 끼우므로 요소마다 걸면 새 그림이 빠진다
        document.addEventListener('click', function (e) {
          var el = e.target;
          if (!el || !el.closest || !el.closest('.prose')) return;
          if (Math.abs(e.clientX - px) > 8 || Math.abs(e.clientY - py) > 8) return;
          if (el.tagName === 'IMG') {
            var src = el.getAttribute('src') || '';
            if (src.indexOf('/p/') !== 0) return;
            open(src, el.alt);
          } else if (el.tagName === 'image') {
            var href = el.getAttribute('href') || '';
            if (href.indexOf('/p/') !== 0) return;
            open(href, el.getAttribute('aria-label') || '');
          }
        });
        lb.addEventListener('click', shut);
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') shut();
        });
      })();
    </script>

    <script is:inline>
      // 마우스로 잡아 끌어 미는 줄 — 트랙패드와 휠은 브라우저가 이미 해 준다.
      // 손을 뗀 뒤 눌린 것으로 오인되는 건 위 8px 가드가 막는다.
      (function () {
        var SEL = '.tml-scroll, .reel-scroll, .shotrow';
        var sc = null, x0 = 0, left0 = 0, moved = false, pid = null;
        document.addEventListener('pointerdown', function (e) {
          if (e.pointerType !== 'mouse' || e.button !== 0) return;
          var el = e.target.closest ? e.target.closest(SEL) : null;
          if (!el || el.scrollWidth - el.clientWidth < 8) return;
          sc = el; x0 = e.clientX; left0 = el.scrollLeft; moved = false; pid = e.pointerId;
        });
        document.addEventListener('pointermove', function (e) {
          if (!sc) return;
          var dx = e.clientX - x0;
          if (!moved && Math.abs(dx) < 4) return;
          if (!moved) {
            moved = true;
            sc.classList.add('grabbing');
            // 잡는 건 실제로 끌기 시작한 뒤에만. 누르자마자 잡으면 클릭이 이 칸으로
            // 되돌려져(retarget) 축의 날짜를 눌러도 아래가 안 펼쳐진다
            // 창 밖에서 손을 떼도 끝이 오게 하려는 것이라 이때 잡아도 충분하다
            try { sc.setPointerCapture(pid); } catch (err) {}
          }
          // 글자·그림이 딸려 잡히지 않게
          e.preventDefault();
          sc.scrollLeft = left0 - dx;
        });
        function end() {
          if (!sc) return;
          sc.classList.remove('grabbing');
          // 끌고 난 직후의 클릭은 누른 것이 아니다 — 한 박자만 표시를 남긴다
          if (moved) {
            var el = sc;
            el.classList.add('dragged');
            setTimeout(function () { el.classList.remove('dragged'); }, 0);
          }
          sc = null;
        }
        document.addEventListener('pointerup', end);
        document.addEventListener('pointercancel', end);
        document.addEventListener('lostpointercapture', end);
        window.addEventListener('blur', end);
        // 끄는 동안 그림이 통째로 끌려가는 기본 동작을 막는다
        document.addEventListener('dragstart', function (e) {
          if (e.target.closest && e.target.closest(SEL)) e.preventDefault();
        });
      })();
    </script>
  </body>
</html>
