---
interface Props {
  /** 가장 센 숫자 하나 — 크게 */
  label: string;
  v: string;
  note?: string;
  /** 전 · 후를 칸 수로 — 켜진 칸 개수. 둘 다 주면 막대 두 줄이 선다 */
  before?: number;
  after?: number;
  /** 나머지 숫자 — 작은 타일 */
  tiles: { label: string; v: string; note?: string }[];
  /** 계산값 같은 근거 한 줄 */
  basis?: string;
}
const { label, v, note, before, after, tiles, basis } = Astro.props;
const cells = Math.max(before ?? 0, after ?? 0);
---

<div class="hero">
  <div class="tile big">
    <div>
      <div class="lb">{label}</div>
      <div class="v">{v}</div>
      {note && <div class="d">{note}</div>}
    </div>
    {cells > 0 && (
      <div class="cells">
        {[['전', before ?? 0], ['후', after ?? 0]].map(([k, n]) => (
          <div class="line">
            {Array.from({ length: cells }, (_, i) => <i class:list={[{ on: i < (n as number) }]} />)}
            <span>{k}</span>
          </div>
        ))}
      </div>
    )}
  </div>
  {tiles.map(t => (
    <div class="tile">
      <div class="lb">{t.label}</div>
      <div class="v">{t.v}</div>
      {t.note && <div class="d">{t.note}</div>}
    </div>
  ))}
  {basis && <p class="basis">{basis}</p>}
</div>
