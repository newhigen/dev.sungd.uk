---
interface Props {
  /** 하루를 가로축 하나에 — 시각은 소수 시(7.5 = 07:30) */
  from: number;
  to: number;
  /** 음영으로 까는 구간 (근무 시간 등) */
  span?: { from: number; to: number; label: string };
  /** 줄마다 블록 몇 개. tone 은 1·2·3 (색), cut 은 span 끝 뒤로 넘친 몫을 빗금으로 */
  rows: {
    label: string;
    blocks: { from: number; to: number; name: string; tone: 1 | 2 | 3 }[];
    count: string;
    cut?: { from: number; to: number };
    marks?: number[];
    marksLabel?: string;
  }[];
  legend?: string[];
  caption?: string;
}
const { from, to, span, rows, legend = [], caption } = Astro.props;

// 본문 폭(약 40rem)에 맞춰 줄어드니 viewBox 를 좁게 잡아 글자가 작아지지 않게 한다
const L = 28, R = 46, W = 600, rowH = 70, top = 26;
const H = top + rows.length * rowH + 22;
const x = (h: number) => L + ((h - from) / (to - from)) * (W - L - R);
const ticks: number[] = [];
for (let h = Math.ceil(from / 3) * 3; h <= to; h += 3) ticks.push(h);
const pad = (h: number) => String(h).padStart(2, '0');
---

<figure class="day">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={caption ?? '하루 타임라인'}>
    <defs>
      <pattern id="day-cut" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="6" stroke="#c98a8a" stroke-width="2.5" />
      </pattern>
    </defs>
    {span && (
      <g>
        <rect class="span" x={x(span.from)} y={top - 8} width={x(span.to) - x(span.from)} height={rows.length * rowH} rx="6" />
        <text class="lbl" x={x(span.from) + 6} y={top - 12}>{span.label}</text>
        <line class="end" x1={x(span.to)} y1={top - 8} x2={x(span.to)} y2={top - 8 + rows.length * rowH} />
      </g>
    )}
    {rows.map((r, i) => {
      const y = top + i * rowH + 12;
      return (
        <g>
          <text class="row" x="0" y={y + 19}>{r.label}</text>
          {r.blocks.map(b => (
            <g>
              {/* 빗금 구간과 겹치면 블록은 거기서 끊고, 남은 몫은 빗금만 남긴다 */}
              <rect class={`blk t${b.tone}`} x={x(b.from)} y={y}
                width={x(r.cut && b.to > r.cut.from ? r.cut.from : b.to) - x(b.from) - (r.cut && b.to > r.cut.from ? 0 : 3)} height="30" rx="6" />
              <text class="bn" x={x(b.from) + 8} y={y + 19}>{b.name}</text>
            </g>
          ))}
          {r.cut && <rect class="cutblk" x={x(r.cut.from)} y={y} width={x(r.cut.to) - x(r.cut.from) - 3} height="30" rx="6" fill="url(#day-cut)" />}
          <text class="cnt" x={W - 4} y={y + 22} text-anchor="end">{r.count}</text>
          {r.marks?.map(m => <circle class="mk" cx={x(m)} cy={y + 42} r="3" />)}
          {r.marksLabel && r.marks && <text class="lbl" x={x(r.marks[0]) + 8} y={y + 46}>{r.marksLabel}</text>}
        </g>
      );
    })}
    {ticks.map(h => <text class="tick" x={x(h)} y={H - 4} text-anchor="middle">{pad(h)}</text>)}
  </svg>
  {legend.length > 0 && (
    <div class="day-legend">
      {legend.map((l, i) => <span><i class:list={[i < 3 ? `t${i + 1}` : 'cut']} />{l}</span>)}
    </div>
  )}
  {caption && <figcaption>{caption}</figcaption>}
</figure>
