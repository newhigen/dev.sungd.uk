---
interface Props {
  /** 편 맨 위 반반 판 — 왼쪽은 말, 오른쪽은 진짜 화면.
   *  브라우저 주소창 같은 기기 틀은 그리지 않는다. 둥근 모서리와 그림자만. */
  label?: string;
  /** 굵은 제목. 줄을 나누고 싶으면 배열로 준다 — 명사구가 아니라 문장이다 */
  title: string | string[];
  sub?: string;
  /** 왼쪽에 세로로 서는 숫자 칩 */
  chips?: { v: string; label: string }[];
  /** 오른쪽 화면. 그림 한 장이면 src, 컴포넌트로 그린 화면이면 자식으로 넣는다 */
  src?: string;
  /** 밤 판에서 갈아 끼울 그림 — Fig 와 같은 관례 */
  srcDark?: string;
  alt?: string;
  /** 숫자의 출처. 실측이 아니면 아니라고 적는다 */
  basis?: string;
}
const { label, title, sub, chips = [], src, srcDark, alt, basis } = Astro.props;
const lines = Array.isArray(title) ? title : [title];
// 오른쪽에 세울 화면이 없으면 한 단으로 — 가로로 넓은 그림은 좁은 셀에서 못 읽는다
const solo = !src && !Astro.slots.has('default');
---

<figure class="pnl">
  <div class={solo ? "pnl-2 solo" : "pnl-2"}>
    <div class="pnl-say">
      {label && <p class="pnl-l">{label}</p>}
      <h3>{lines.map((l, i) => <>{i > 0 && <br />}{l}</>)}</h3>
      {sub && <p class="pnl-s">{sub}</p>}
      {chips.length > 0 && (
        <div class="pnl-chips">
          {chips.map(c => <span><b>{c.v}</b>{c.label}</span>)}
        </div>
      )}
    </div>
    {!solo && <div class="pnl-shot">
      {src
        ? (srcDark
            ? <picture>
                <source srcset={srcDark} media="(prefers-color-scheme: dark)" />
                <img src={src} alt={alt ?? ''} />
              </picture>
            : <img src={src} alt={alt ?? ''} />)
        : <slot />}
    </div>}
  </div>
  {basis && <figcaption class="pnl-b">{basis}</figcaption>}
</figure>
