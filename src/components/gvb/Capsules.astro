---
/**
 * 갤럭시 음성 브리지 — Mac 화면 아래 캡슐의 상태 넷.
 * 크기·색·여백은 galaxy-voice-bridge mac/hotkey/main.swift 의 CapsuleContentView 값 그대로
 * (높이 42 · 점 7 · 간격 9 · 좌우 15 · 13pt medium · 막대 10개 2px/3px).
 * (2026-09-14 캡처 한 장이 여백만 넓다는 지적 → 상태 넷을 나란히)
 */
interface Props { caption?: string }
const { caption } = Astro.props;

const bars = [0.3, 0.55, 0.4, 0.85, 0.6, 1, 0.5, 0.75, 0.35, 0.5];
const states = [
  { text: '녹음 중', tone: 'rec', wave: true, when: '첫 Option+Space' },
  { text: '전사 중…', tone: 'run', when: '두 번째 Option+Space' },
  { text: '완료', tone: 'ok', when: '붙여넣기 · 1.2초 뒤 닫힘' },
  { text: '음성 없음', tone: 'none', when: '전사문이 비면 · 1.5초' },
];
---

<figure class="caps wide">
  <div class="caps-grid">
    {states.map((s) => (
      <div class="cap-cell">
        <span class={`cap ${s.tone}`}>
          <i></i>{s.text}
          {s.wave && <b>{bars.map((h) => <em style={`height:${Math.max(3, Math.round(h * 22))}px`}></em>)}</b>}
        </span>
        <small>{s.when}</small>
      </div>
    ))}
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
