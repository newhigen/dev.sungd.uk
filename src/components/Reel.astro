---
interface Props {
  /** 후보를 그려 놓고 고른 판들을 한 줄에 — 세로로 쌓으면 절이 본문보다 무거워진다.
   *  그림을 누르면 크게 뜨고(Base 의 위임이 받는다), 캡션의 링크가 그 판으로 간다. */
  items: {
    src: string;
    /** 그 판에서 물은 것 — 판 이름이 아니라 물음이 머리에 선다 */
    q: string;
    /** 후보 수. 「8안」 이라 쓰는 대신 뱃지로 그림 위에 얹는다 */
    n?: number;
    note?: string;
    href?: string;
    alt?: string;
  }[];
  caption?: string;
}
const { items, caption } = Astro.props;
const uid = 'reel-' + Math.random().toString(36).slice(2, 9);
---

<figure class="reel" id={uid} data-edge="start">
  <div class="reel-scroll">
    <div class="track">
      {items.map(it => (
        <figure>
          {it.n && <span class="cnt">{it.n}안</span>}
          <img src={it.src} alt={it.alt ?? it.q} />
          <figcaption>
            <b>{it.q}</b>
            {it.note}
            {it.href && <a href={it.href}>후보 보기</a>}
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
  {caption && <figcaption class="cap">{caption}</figcaption>}
</figure>

<script is:inline define:vars={{ uid }}>
  (function () {
    var box = document.getElementById(uid);
    if (!box) return;
    var sc = box.querySelector('.reel-scroll');
    function edge() {
      var max = sc.scrollWidth - sc.clientWidth;
      if (max < 8) return box.setAttribute('data-edge', 'none');
      box.setAttribute('data-edge',
        sc.scrollLeft < 8 ? 'start' : sc.scrollLeft > max - 8 ? 'end' : 'mid');
    }
    sc.addEventListener('scroll', edge, { passive: true });
    window.addEventListener('resize', edge);
    edge();
  })();
</script>
