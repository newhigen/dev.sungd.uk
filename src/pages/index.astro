---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Badge from '../components/Badge.astro';
import { PURPOSE, STATUS } from '../content.config';

const all = await getCollection('projects');

function num(p: string) {
  const m = p.match(/(\d{4})\.(\d{2})(?:\.(\d{2}))?/);
  return m ? Number(m[1]) * 10000 + Number(m[2]) * 100 + Number(m[3] ?? 0) : 0;
}
/** 목록에는 월까지만 — 2026.05.30 → 2026.05 */
function ym(p: string) { return p.slice(0, 7); }
/** 로고에 붙는 이름 — 그림만 두면 무엇인지 읽어 줄 수 없다 */
const PLAT_NAME: Record<string, string> = {
  android: '안드로이드', apple: 'Mac', terminal: '터미널',
};

const sorted = [...all].sort((a, b) => num(b.data.period) - num(a.data.period));
// 지금 쓰는 것(사용 중 · 페이지 있음)은 카드로 크게, 나머지(보류 · 완료 · 종료 · 페이지 없는 편)는 한 줄 목록
// (2026-09-13 docs/explore/home.html 의 B + C)
// 맨 위 한 자리 — 기간을 제치고 앞에 선다. 자리가 하나라야 「맨 위」가 뜻이 있다
const pinned = sorted.filter(p => p.data.pin);
if (pinned.length > 1) {
  throw new Error(`맨 위 한 자리에 ${pinned.length}편이 있다 — ${pinned.map(p => p.id).join(', ')}`);
}
const live = sorted
  .filter(p => p.data.status === '사용 중' && !p.data.draft)
  .sort((a, b) => Number(b.data.pin) - Number(a.data.pin));
// 같이 쓰는 편 — with 는 한쪽에만 적고 양쪽 카드에 세운다.
// 두 편에 겹쳐 적으면 한쪽을 지울 때 다른 쪽이 짝 없는 이름을 가리키게 된다
const names = new Map(all.map(p => [p.id, p.data.title]));
const pairs = new Map<string, Set<string>>();
for (const p of all) {
  for (const s of p.data.with) {
    if (!names.has(s)) throw new Error(`${p.id} 의 with 가 없는 편을 가리킨다 — ${s}`);
    if (!pairs.has(p.id)) pairs.set(p.id, new Set());
    if (!pairs.has(s)) pairs.set(s, new Set());
    pairs.get(p.id)!.add(s);
    pairs.get(s)!.add(p.id);
  }
}
/** 받침이 있으면 «과», 없으면 «와» — 한글 음절은 0xAC00 부터 28 개씩 한 벌이고
    그 안의 자리가 0 이면 받침이 없다 */
function gwa(name: string) {
  const c = name.charCodeAt(name.length - 1) - 0xac00;
  return c >= 0 && c <= 11171 && c % 28 !== 0 ? '과' : '와';
}
/** 그 편의 짝을 이름으로 — 없으면 빈 배열 */
const pairsOf = (id: string) =>
  [...(pairs.get(id) ?? [])].map(s => ({ id: s, title: names.get(s)!, gwa: gwa(names.get(s)!) }));
const past = sorted.filter(p => !live.includes(p));
const purposes = PURPOSE.map(g => ({ name: g, n: all.filter(p => p.data.purpose === g).length }))
  .filter(g => g.n > 0);
const statuses = STATUS.map(s => ({ name: s, n: all.filter(p => p.data.status === s).length }))
  .filter(s => s.n > 0);
---

<Base title="프로젝트">
  {/* 제호 바로 아래 — 거르는 칸 안에 두면 그 칸의 머리말로 읽힌다 */}
  <p class="lede">직접 쓰려고 만든 앱과 도구. 하루에 걸리적거리던 것에서 시작했다.</p>

  <div class="home">
    <aside class="pick-rail">
      <nav class="pick" data-key="갈래" aria-label="갈래">
        <div class="lb">갈래</div>
        <button type="button" class="on" data-pick="">전체<span class="n">{all.length}</span></button>
        {purposes.map(g => (
          <button type="button" data-pick={g.name}>{g.name}<span class="n">{g.n}</span></button>
        ))}
      </nav>

      <nav class="pick st" data-key="상태" aria-label="상태">
        <div class="lb">상태</div>
        {statuses.map(s => (
          <button type="button" data-pick={s.name}><Badge status={s.name} /><span class="n">{s.n}</span></button>
        ))}
      </nav>
    </aside>

    <div class="lists">
      <section class="grp">
        <h2 class="sec">지금 쓰는 것<span class="n">{live.length}</span></h2>
        <div class="cards">
          {live.map(p => {
            const d = p.data;
            return (
              <article class="card" data-purpose={d.purpose} data-status={d.status}>
                {/* 위는 화면 — 누르면 크게 뜬다. 여러 장이면 옆으로 민다 */}
                <div class="shotrow">
                  {d.screens.length ? d.screens.map((s, i) => (
                    <button class="shotrow-i" type="button" data-src={s.src} data-label={s.label}
                      data-of={d.title} aria-label={`${d.title} — ${s.label || '화면'} 크게 보기`}>
                      <img src={s.src} alt={s.label} loading="lazy" />
                    </button>
                  )) : (d.icon
                    ? <img class="icon" src={d.icon} alt="" />
                    : <span class="icon ph">{d.title.slice(0, 1)}</span>)}
                </div>
                {/* 아래는 글 — 누르면 그 편으로 간다 */}
                <a class="body" href={`/${p.id}`}>
                  <div class="nm">{d.title}</div>
                  <p class="ds">{d.tagline}</p>
                  {/* 같이 쓰는 편 — 짝이 없는 카드도 한 줄 몫을 비워 둔다.
                      안 그러면 짝 있는 카드만 길어져 아래 줄이 어긋난다
                      (2026-09-27 docs/explore/related-a.html 의 A-4) */}
                  <p class="card-with">
                    {pairsOf(p.id).map((w, i) => (
                      <>{i > 0 && ', '}↳ <b>{w.title}</b>{w.gwa} 함께</>
                    ))}
                  </p>
                  {/* 플랫폼 아이콘은 제목 줄이 아니라 여기 선다 — 제목 옆에 두면
                      좁은 칸에서 제목이 접히거나 아이콘만 다음 줄로 떨어진다
                      (2026-09-28 폰 두 열) */}
                  <div class="mt">
                    <span class="mt-l">
                      <span class="chip-g">{d.purpose}</span>
                      {d.platform.length > 0 && (
                        <span class="plat">
                          {d.platform.map((k) => (
                            <img src={`/i/${k}.svg`} alt={PLAT_NAME[k]} title={PLAT_NAME[k]} />
                          ))}
                        </span>
                      )}
                    </span>
                    <span class="when">{ym(d.period)}</span>
                  </div>
                </a>
              </article>
            );
          })}
        </div>
      </section>

      <section class="grp">
        <h2 class="sec">나머지<span class="n">{past.length}</span></h2>
        <div class="prows">
          {past.map(p => {
            const d = p.data;
            const body = (
              <>
                <span class="ri">{d.icon ? <img src={d.icon} alt="" /> : <i />}</span>
                <span class="rn">{d.title}</span>
                <span class="rd">{d.tagline}</span>
                <span class="rp">{d.purpose}</span>
                <span class="rb"><Badge status={d.status} /></span>
                <span class="ry">{ym(d.period)}</span>
              </>
            );
            return d.draft
              ? <div class="prow bare" data-purpose={d.purpose} data-status={d.status}>{body}</div>
              : <a class="prow" href={`/${p.id}`} data-purpose={d.purpose} data-status={d.status}>{body}</a>;
          })}
        </div>
      </section>
    </div>
  </div>
  {/* 화면을 크게 보는 판. 열릴 때까지 비어 있다 */}
  <dialog class="shotbox" aria-label="화면 크게 보기">
    <button class="shotbox-x" type="button" aria-label="닫기">✕</button>
    <div class="shotbox-fig">
      <img alt="" />
      <p class="shotbox-cap"></p>
      {/* 여러 장이면 썸네일로 넘긴다. 한 장이면 비어 있다 */}
      <div class="shotbox-th" role="tablist" aria-label="이 편의 화면들"></div>
    </div>
  </dialog>
</Base>

<script>
  // 갈래 · 상태 두 거르기 — 둘 다 맞는 것만 남기고, 비는 묶음은 접는다.
  // 주소(?갈래= · ?상태=)에 남겨 링크로 건넬 수 있다. 같은 칩을 다시 누르면 풀린다.
  function init() {
    const navs = [...document.querySelectorAll<HTMLElement>('.pick[data-key]')];
    if (!navs.length) return;
    const items = [...document.querySelectorAll<HTMLElement>('.lists [data-purpose]')];
    const groups = [...document.querySelectorAll<HTMLElement>('.lists .grp')];
    const state: Record<string, string> = {};

    function apply() {
      for (const nav of navs) {
        const v = state[nav.dataset.key!] ?? '';
        nav.querySelectorAll<HTMLButtonElement>('button').forEach(b => b.classList.toggle('on', (b.dataset.pick ?? '') === v));
      }
      const g = state['갈래'] ?? '', s = state['상태'] ?? '';
      for (const it of items) it.hidden = (!!g && it.dataset.purpose !== g) || (!!s && it.dataset.status !== s);
      for (const grp of groups) {
        const shown = grp.querySelectorAll('[data-purpose]:not([hidden])').length;
        grp.hidden = shown === 0;
        const n = grp.querySelector('.sec .n');
        if (n) n.textContent = String(shown);
      }
      const u = new URL(location.href);
      for (const k of ['갈래', '상태']) state[k] ? u.searchParams.set(k, state[k]) : u.searchParams.delete(k);
      history.replaceState(history.state, '', u);
    }

    const url = new URL(location.href);
    for (const nav of navs) {
      const k = nav.dataset.key!;
      const want = url.searchParams.get(k) ?? '';
      if ([...nav.querySelectorAll('button')].some(b => b.dataset.pick === want)) state[k] = want;
      nav.addEventListener('click', e => {
        const b = (e.target as HTMLElement).closest('button');
        if (!b) return;
        const v = b.dataset.pick ?? '';
        state[k] = state[k] === v ? '' : v;
        apply();
      });
    }
    apply();
  }

  /** 카드 위쪽 화면을 누르면 크게 — 그 카드 안에서 앞뒤로 넘긴다 */
  function lightbox() {
    const lb = document.querySelector<HTMLDialogElement>('.shotbox');
    if (!lb) return;
    const img = lb.querySelector('img')!;
    const cap = lb.querySelector('.shotbox-cap')!;
    const rail = lb.querySelector('.shotbox-th')!;
    let group: HTMLButtonElement[] = [];
    let at = 0;

    /** 그 카드의 화면들을 썸네일 줄로 세운다 — 판을 열 때 한 번 */
    function rebuild() {
      rail.textContent = '';
      // 한 장뿐이면 넘길 것이 없으니 줄 자체를 세우지 않는다
      lb.classList.toggle('one', group.length < 2);
      if (group.length < 2) return;
      group.forEach((b, i) => {
        const t = document.createElement('button');
        t.type = 'button';
        t.className = 'shotbox-t';
        t.dataset.i = String(i);
        t.setAttribute('role', 'tab');
        t.setAttribute('aria-label', b.dataset.label || `화면 ${i + 1}`);
        const im = document.createElement('img');
        im.src = b.dataset.src!;
        im.alt = '';
        t.append(im);
        rail.append(t);
      });
    }

    function show(i: number) {
      const b = group[(i + group.length) % group.length];
      if (!b) return;
      at = (i + group.length) % group.length;
      img.src = b.dataset.src!;
      img.alt = b.dataset.label || '';
      cap.textContent = [b.dataset.of, b.dataset.label].filter(Boolean).join(' — ');
      rail.querySelectorAll('.shotbox-t').forEach((t, j) => {
        t.classList.toggle('on', j === at);
        t.setAttribute('aria-selected', String(j === at));
      });
    }

    document.querySelector('.cards')?.addEventListener('click', e => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.shotrow-i');
      if (!b) return;
      // 끌어서 민 직후의 클릭은 확대가 아니다
      if (b.closest('.shotrow')?.classList.contains('dragged')) return;
      group = [...b.closest('.shotrow')!.querySelectorAll<HTMLButtonElement>('.shotrow-i')];
      rebuild();
      show(group.indexOf(b));
      lb.showModal();
    });

    lb.querySelector('.shotbox-x')!.addEventListener('click', () => lb.close());
    rail.addEventListener('click', e => {
      const t = (e.target as HTMLElement).closest<HTMLButtonElement>('.shotbox-t');
      if (t) show(Number(t.dataset.i));
    });
    lb.addEventListener('keydown', e => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(at - 1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); show(at + 1); }
    });

    // 폰에서 좌우로 밀어 넘긴다 — 썸네일은 작아서 손가락으로 겨냥하기 어렵다.
    // 세로로 긋는 것은 스크롤이지 넘기기가 아니라 방향을 보고 가른다.
    let sx = 0, sy = 0, dx = 0, swiping = false;
    function slide(px: number, fade: boolean) {
      img.style.transform = px ? `translateX(${px}px)` : '';
      img.style.opacity = fade ? String(1 - Math.min(Math.abs(px) / 420, 0.4)) : '';
    }
    img.addEventListener('pointerdown', e => {
      if (group.length < 2) return;
      sx = e.clientX; sy = e.clientY; dx = 0; swiping = true;
      img.style.transition = '';
      img.setPointerCapture(e.pointerId);
    });
    img.addEventListener('pointermove', e => {
      if (!swiping) return;
      const mx = e.clientX - sx, my = e.clientY - sy;
      if (Math.abs(my) > Math.abs(mx) && Math.abs(my) > 12) { swiping = false; slide(0, false); return; }
      dx = mx;
      e.preventDefault();
      slide(dx, true);
    });
    function endSwipe() {
      if (!swiping) return;
      swiping = false;
      const moved = dx;
      dx = 0;
      if (Math.abs(moved) > 48) {
        // 넘긴 뒤에는 새 그림이 제자리에서 시작해야 한다
        slide(0, false);
        show(at + (moved < 0 ? 1 : -1));
        return;
      }
      img.style.transition = 'transform .16s ease, opacity .16s ease';
      slide(0, false);
      setTimeout(() => { img.style.transition = ''; }, 180);
    }
    img.addEventListener('pointerup', endSwipe);
    img.addEventListener('pointercancel', endSwipe);
    img.addEventListener('lostpointercapture', endSwipe);
    // 그림 바깥(판 자체)을 누르면 닫는다
    lb.addEventListener('click', e => { if (e.target === lb) lb.close(); });
  }

  document.addEventListener('astro:page-load', () => { init(); lightbox(); });
</script>
