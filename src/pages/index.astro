---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Badge from '../components/Badge.astro';
import { PURPOSE } from '../content.config';

const all = await getCollection('projects');

function num(p: string) {
  const m = p.match(/(\d{4})\.(\d{2})(?:\.(\d{2}))?/);
  return m ? Number(m[1]) * 10000 + Number(m[2]) * 100 + Number(m[3] ?? 0) : 0;
}
/** 목록에는 월까지만 — 2026.05.30 → 2026.05 */
function ym(p: string) { return p.slice(0, 7); }

// 상태로 절을 나누지 않는다 — 카드마다 배지가 선다. 최근 것이 위
const sorted = [...all].sort((a, b) => num(b.data.period) - num(a.data.period));
const purposes = PURPOSE.map(g => ({ name: g, n: all.filter(p => p.data.purpose === g).length }))
  .filter(g => g.n > 0);
---

<Base title="프로젝트">
  <p class="lede">
    직접 쓰려고 만든 앱과 도구. 대개 내 하루에 걸리적거리던 것에서 시작했다. 보류하거나 종료한
    것도 까닭과 함께 남겨 둔다.
  </p>

  <nav class="filter" aria-label="갈래">
    <button type="button" class="on" data-pick="">전체<span class="n">{all.length}</span></button>
    {purposes.map(g => (
      <button type="button" data-pick={g.name}>{g.name}<span class="n">{g.n}</span></button>
    ))}
  </nav>

  <div class="cards">
    {sorted.map(p => {
      const d = p.data;
      const body = (
        <>
          {d.icon && <img class="icon" src={d.icon} alt="" />}
          {d.kind && <div class="kd">{d.kind}</div>}
          <div class="nm">{d.title}</div>
          <p class="ds">{d.tagline}</p>
          {d.ended && <p class="ed">{d.ended}</p>}
          <div class="mt"><Badge status={d.status} /><span>{d.purpose} · {ym(d.period)}</span></div>
        </>
      );
      const cls = ['card', { bare: d.draft, noicon: !d.icon }];
      return d.draft
        ? <div class:list={cls} data-purpose={d.purpose}>{body}</div>
        : <a class:list={cls} href={`/${p.id}`} data-purpose={d.purpose}>{body}</a>;
    })}
  </div>
</Base>

<script>
  // 갈래 칩 — 고른 갈래만 남긴다. 주소(?갈래=)에 남겨 링크로 건넬 수 있다.
  function init() {
    const bar = document.querySelector<HTMLElement>('.filter');
    if (!bar) return;
    const buttons = [...bar.querySelectorAll<HTMLButtonElement>('button')];
    const cards = [...document.querySelectorAll<HTMLElement>('.cards [data-purpose]')];

    function apply(pick: string) {
      buttons.forEach(b => b.classList.toggle('on', b.dataset.pick === pick));
      for (const c of cards) c.hidden = !!pick && c.dataset.purpose !== pick;
    }

    const url = new URL(location.href);
    const start = url.searchParams.get('갈래') ?? '';
    apply(buttons.some(b => b.dataset.pick === start) ? start : '');

    bar.addEventListener('click', e => {
      const b = (e.target as HTMLElement).closest('button');
      if (!b) return;
      const pick = b.dataset.pick ?? '';
      apply(pick);
      const u = new URL(location.href);
      if (pick) u.searchParams.set('갈래', pick); else u.searchParams.delete('갈래');
      history.replaceState(history.state, '', u);
    });
  }
  document.addEventListener('astro:page-load', init);
</script>
