---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Badge from '../components/Badge.astro';
import Tabs from '../components/Tabs.astro';
import Toc from '../components/Toc.astro';

export async function getStaticPaths() {
  // 아직 안 여는 것은 페이지도 안 만든다 — 목록에 이름만 남는다.
  const all = await getCollection('projects');
  return all
    .filter(entry => !entry.data.draft)
    .map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
// 개발기가 따로 있으면 두 화면을 탭으로 잇는다.
const making = await getEntry('making', entry.id);
const why = await getEntry('why', entry.id);
// 차례 — 본문 h2 에 템플릿이 붙이는 「그전 모습」 까지
const toc = headings.filter(h => h.depth <= 3).map(({ slug, text, depth }) => ({ slug, text, depth }));
if (d.shots.length > 0) toc.push({ slug: 'shots', text: '이전 버전' });
---

<Base title={d.title} description={d.tagline} image={d.cover}>
  <header class="doc-head">
    <h1 transition:name="doc-title">{d.title} <Badge status={d.status} /></h1>
    <p class="tagline">{d.tagline}</p>
  </header>

  {(making || why) && <Tabs here="intro" slug={entry.id} />}

  <div class="doc-body">
    <aside class="rail" transition:name="rail">
      <dl>
        {d.kind && <><dt>종류</dt><dd>{d.kind}</dd></>}
        <dt>기간</dt>
        <dd class="when">{d.period}</dd>
        <dt>갈래</dt>
        <dd>{d.purpose}</dd>
        {d.ended && <><dt>{d.status}</dt><dd class="ended">{d.ended}</dd></>}
        {d.tags.length > 0 && <><dt>스택</dt><dd>{d.tags.join(' · ')}</dd></>}
        {(d.github || d.link) && (
          <>
            <dt>링크</dt>
            {d.github && <dd><a href={d.github}>GitHub ↗</a></dd>}
            {d.link && <dd><a href={d.link}>{d.linkLabel ?? '사이트'} ↗</a></dd>}
          </>
        )}
      </dl>
      <Toc items={toc} />
    </aside>

    <div class="paper">
      {d.headCover && d.cover && (
        <figure>
          <img src={d.cover} alt="" class:list={[{ 'only-dark': d.coverLight }]} />
          {d.coverLight && <img src={d.coverLight} alt="" class="only-light" />}
        </figure>
      )}

      <article class="prose">
        <Content />
      </article>

      {d.shots.length > 0 && (
        <section>
          <h2 class="prose" id="shots">이전 버전</h2>
          <div class="shots">
            {d.shots.map(s => (
              <figure>
                <img src={s.src} alt={s.label} loading="lazy" />
                <figcaption>{s.label}{s.note && <><br />{s.note}</>}</figcaption>
              </figure>
            ))}
          </div>
        </section>
      )}
    </div>
  </div>
</Base>
